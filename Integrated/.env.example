# ==============================================================================
# Face ID + Blockchain Verification Pipeline Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Part B: Reverse Image Search & Visual Verification (SerpApi / Google Lens)
# ------------------------------------------------------------------------------
# Get your free key from https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# ------------------------------------------------------------------------------
# Part C: Blockchain Verification (Ethereum Sepolia Testnet)
# ------------------------------------------------------------------------------
# 1. RPC URL: Alchemy / Infura / QuickNode (e.g., https://eth-sepolia.g.alchemy.com/v2/...)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# 2. Private Key: MetaMask -> Account Details -> Export Private Key
PRIVATE_KEY=your_private_key_here

# 3. Contract Address: Deployed StoreRecord contract address from Remix
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 4. (Optional) Custom ABI as single-line JSON. If omitted, built-in StoreRecord ABI is used.
# CONTRACT_ABI=[{"inputs":[...],"name":"storeRecord",...}]
