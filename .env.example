# ─────────────────────────────────────────────────────────────
# .env — Part C environment variables (copy from .env.example)
# ─────────────────────────────────────────────────────────────

# Ethereum Sepolia JSON-RPC endpoint.
# Free options: Alchemy, Infura, or QuickNode — sign up and paste the URL.
# Example: https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
RPC_URL=

# The private key of the wallet that will submit transactions.
# ⚠️  NEVER commit this to version control!
# Export from MetaMask: Account Details → Export Private Key
# Must have Sepolia ETH for gas — grab some from https://sepoliafaucet.com
PRIVATE_KEY=

# Address of the deployed StoreRecord contract on Sepolia.
# You get this after deploying via Remix (Injected Provider → Sepolia).
CONTRACT_ADDRESS=

# Full ABI of the StoreRecord contract (JSON array, single line).
# Copy from Remix: Compilation Details → ABI → copy icon.
# Paste the entire JSON array as a single line, e.g.:
# CONTRACT_ABI=[{"inputs":[...],"name":"storeRecord",...},...]
CONTRACT_ABI=